# Sanity CMS — get these from sanity.io/manage after creating a project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional — server-only token for previewing drafts (read-only)
SANITY_API_TOKEN=

# Analytics runs via Vercel Analytics + Speed Insights (no GA4, no env var needed).

# SEO — paste the token from Google Search Console (Settings → Ownership
# verification → HTML tag). Leave blank until you set that up.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Forms — pick one
RESEND_API_KEY=
# FORMSPREE_ENDPOINT=

# Careers form — where applications go and which sender Resend uses.
# The sender MUST be on the Resend-verified domain: forms.jlmorison.com
HR_EMAIL=Hrd@jlmorison.com
RESEND_FROM_EMAIL=careers@forms.jlmorison.com

# Contact-us form — comma-separated recipients + sender.
# Recipients stay on @jlmorison.com; the sender must be on forms.jlmorison.com.
CONTACT_TO_EMAILS=customercare@jlmorison.com,info@jlmorison.com
CONTACT_FROM_EMAIL=website@forms.jlmorison.com

# Video storage — NOTE: not read by the app. Videos live in the GCS bucket
# jlm_website_v2 and are served via videos.jlmorison.com (see docs/05-MEDIA.md).
GCS_BUCKET_NAME=jlm_website_v2
